{
  "name": "ovenglow-playwright-automation",
  "version": "1.0.0",
  "description": "Enterprise-grade E2E & API test automation framework for OvenGlow Bakery built with Playwright, TypeScript, and Page Object Model.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=Chromium",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.14.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.12.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.4.5"
  }
}
